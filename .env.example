# ============================================================
# nares-sales-updater — credenziali (file gitignored, non committare)
# Copia questo file in .env e inserisci i valori reali.
# La password NARES cambia ogni 3 mesi: si aggiorna SOLO qui.
# ============================================================

# Portale NARES
NARES_USERNAME=your_nares_username
NARES_PASSWORD=your_nares_password

# SQL Server (GenesiRetail)
SQL_SERVER=your_sql_server_host
SQL_USERNAME=your_sql_user
SQL_PASSWORD=your_sql_password
